# 配置文档参考 https://taro-docs.jd.com/docs/next/env-mode-config
# TARO_APP_ID="开发环境下的小程序 AppID"

# 接口模式：mock（本地内存数据，后端未就绪时使用）| real（真实后端）
TARO_APP_API_MODE=real

# 真实后端地址（阿里云 ECS）
#   http://118.190.152.29/api/v1  →  nginx 反代  →  API:8000
# 本地联调请改回 http://127.0.0.1:8000/api/v1
TARO_APP_API_BASE_URL=http://118.190.152.29/api/v1
