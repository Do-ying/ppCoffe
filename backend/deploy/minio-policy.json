{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::ppcoffe-brew",
        "arn:aws:s3:::ppcoffe-brew/*",
        "arn:aws:s3:::ppcoffe-roast",
        "arn:aws:s3:::ppcoffe-roast/*",
        "arn:aws:s3:::ppcoffe-tmp",
        "arn:aws:s3:::ppcoffe-tmp/*"
      ]
    }
  ]
}
