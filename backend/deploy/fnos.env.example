# ppCoffe · fnOS Docker 部署环境变量（模板）
#
# 用法：复制为 .env 后填入真实值
#   cp fnos.env.example .env
#
# ⚠️ 本文件只含占位符，真实 .env 不要提交（已在 .gitignore 中）。

# ---- 应用 ----
APP_ENV=production
PUBLIC_BASE_URL=http://192.168.31.13:8080
# 生成：python3 -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=<改成随机值>
JWT_SECRET=<改成随机值>
AUTH_MODE=dev
WECHAT_APPID=
WECHAT_SECRET=

# ---- 端口（fnOS 上 80/443/8000/9000 等已被占用）----
API_PORT=8080
WEB_PORT=8081
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# ---- 数据库：复用 fnOS 上已有的 mysql:8.4.1 容器 ----
# 该容器的宿主机映射端口是 3360（不是容器内 3306）
# 容器内访问宿主机走 docker0 网关 172.17.0.1（host.docker.internal 在 Linux 上不解析）
DATABASE_URL=mysql+pymysql://ppcoffe:<密码>@172.17.0.1:3360/ppcoffe?charset=utf8mb4
MYSQL_ROOT_PASSWORD=<改成实际密码>
MYSQL_USER=ppcoffe
MYSQL_PASSWORD=<改成实际密码>
MYSQL_DATABASE=ppcoffe

# ---- 缓存 ----
REDIS_URL=redis://redis:6379/0
REDIS_PORT=16379

# ---- 对象存储 ----
STORAGE_DRIVER=minio
MINIO_ROOT_USER=ppcoffe-root
MINIO_ROOT_PASSWORD=<改成随机值>
MINIO_APP_ACCESS_KEY=ppcoffe
MINIO_APP_SECRET_KEY=<改成随机值>
# ⚠️ 必须与浏览器实际访问的 host:port 完全一致（SigV4 把 Host 算进签名）。
#    走 frp 代理后改成对外地址，并同步重建前端。
MINIO_PUBLIC_ENDPOINT=192.168.31.13:19000
MINIO_PUBLIC_BASE_URL=
MINIO_BUCKET_BREW=ppcoffe-brew
MINIO_BUCKET_ROAST=ppcoffe-roast
MINIO_BUCKET_TEMP=ppcoffe-tmp

# ---- 构建参数 ----
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
