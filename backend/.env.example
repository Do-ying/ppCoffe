# ---------------------------------------------------------------------
#  ppCoffe 后端配置示例
#  复制为 backend/.env 后按需修改；生产环境请用环境变量注入敏感信息
# ---------------------------------------------------------------------

# 应用
APP_ENV=development          # development | testing | production
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-in-production-0123456789abcdef
CORS_ORIGINS=*

# ---------------------------------------------------------------------
#  数据库（MySQL 8）
# ---------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://ppcoffe:ppcoffe@127.0.0.1:3306/ppcoffe?charset=utf8mb4
# 本地无 MySQL 时可临时用 SQLite 跑通链路：
# DATABASE_URL=sqlite:///var/ppcoffe.db
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=10

# ---------------------------------------------------------------------
#  鉴权
#   wechat —— 微信小程序登录（生产）
#   dev    —— 开发登录，code 直接当 openid（联调）
#   none   —— 不校验（个人单机）
# ---------------------------------------------------------------------
AUTH_MODE=dev
JWT_SECRET=change-me-too
JWT_ACCESS_TTL=604800       # 7 天
JWT_REFRESH_TTL=2592000     # 30 天
WECHAT_APPID=
WECHAT_SECRET=

# ---------------------------------------------------------------------
#  Redis（可选，未配置则自动降级为无缓存）
# ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=ppcoffe
CACHE_TTL_METADATA=3600
CACHE_TTL_STATS=60

# ---------------------------------------------------------------------
#  对象存储
#   minio —— 生产（预签名直传）
#   local —— 本地文件系统兜底，便于无 MinIO 时联调
# ---------------------------------------------------------------------
STORAGE_DRIVER=minio
# 容器内网端点：API 读写对象走这个
MINIO_ENDPOINT=minio:9000
# 预签名端点：前端能解析、且能直连的 host:port。
# SigV4 把 Host 计入签名，此处必须与前端实际访问的地址一致，否则直传报
# SignatureDoesNotMatch。留空则复用 MINIO_ENDPOINT。
MINIO_PUBLIC_ENDPOINT=118.190.152.29:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# 显式指定 region 可避免 SDK 在预签名时联网查 GetBucketLocation
MINIO_REGION=us-east-1
# MinIO root 凭据（容器启动用）与应用专用受限账号（API 用）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_APP_ACCESS_KEY=ppcoffe
MINIO_APP_SECRET_KEY=change-me-minio-app-password
# 配了 CDN / 反代域名就填，否则退化为预签名 GET
MINIO_PUBLIC_BASE_URL=
MINIO_BUCKET_BREW=ppcoffe-brew
MINIO_BUCKET_ROAST=ppcoffe-roast
MINIO_BUCKET_TEMP=ppcoffe-tmp
MINIO_URL_TTL=604800
LOCAL_STORAGE_ROOT=./var/uploads
